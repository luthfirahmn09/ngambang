{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ngambang",
  "version": "0.1.0",
  "identifier": "dev.luthfi.ngambang",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ngambang",
        "width": 380,
        "height": 520,
        "minWidth": 280,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
